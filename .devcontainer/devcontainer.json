{
  "name": "goat_racer",
  "dockerComposeFile": [
    "../docker/compose.dev.yaml"
  ],
  "service": "goat-dev",
  "workspaceFolder": "/workspace/goat_racer",
  "overrideCommand": false,
  "shutdownAction": "stopCompose",
  "remoteUser": "root",
  "postCreateCommand": "/bin/bash .devcontainer/post_create.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-iot.vscode-ros",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools",
        "ms-toolsai.jupyter"
      ]
    }
  }
}
