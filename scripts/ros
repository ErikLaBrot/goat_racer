#!/usr/bin/env bash
# Workspace ROS container helper.
#
# Purpose:
#   Start the shared ROS container and run workspace-scoped bootstrap, build,
#   or test flows against the nested GOAT repositories from the `goat_racer`
#   checkout.
#
# Inputs:
#   A subcommand of `up`, `down`, `bootstrap`, `build`, or `test`, plus any
#   extra colcon arguments for the build and test paths.
#
# Outputs:
#   Starts or stops the Docker container, optionally populates nested
#   repositories and ROS dependencies, and writes build, install, log, and test
#   artifacts under `ros_ws/`.
#
# Usage:
#   scripts/ros up
#   scripts/ros bootstrap
#   scripts/ros build --packages-up-to goat_ros_launch
#   scripts/ros test --packages-select goat_ros_launch
#
# Notes:
#   Bootstrap, build, and test commands automatically start the container if
#   needed and shut it down again on exit.
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
compose_file="$repo_root/docker/compose.yaml"
service_name="ros-humble"
workspace_root="/workspace/goat_racer"
workspace_dir="$workspace_root/ros_ws"
build_root="$workspace_dir"
workspace_source_roots=(
  /workspace/goat_racer/external
  /workspace/goat_racer/ros_ws/src
)
legacy_goat_ros_path="$repo_root/ros_ws/src/.git"
canonical_goat_ros_path="$repo_root/ros_ws/src/goat_ros/.git"
legacy_isaac_ros_common_path="$repo_root/ros_ws/src/isaac_ros_common/.git"
canonical_isaac_ros_common_path="$repo_root/ros_ws/src/isaac_ros/isaac_ros_common/.git"

usage() {
  cat <<'EOF'
Usage: scripts/ros <up|down|bootstrap|build|test> [args...]

Commands:
  up                  Start the ROS Docker container in detached mode
  down                Stop and remove the ROS Docker container
  bootstrap           Import nested repos, install ROS deps, and build the workspace
  build [args...]     Ensure the container is running, then run colcon build across the nested ROS workspace
  test [args...]      Ensure the container is running, build, test, and print test results

Examples:
  scripts/ros up
  scripts/ros bootstrap
  scripts/ros build --packages-up-to goat_ros_launch
  scripts/ros test --packages-select goat_ros_launch
EOF
}

run_compose() {
  printf 'Running:'
  printf ' %q' docker compose -f "$compose_file" "$@"
  printf '\n'
  docker compose -f "$compose_file" "$@"
}

run_in_container() {
  local script="$1"
  shift

  printf 'Running:'
  printf ' %q' docker compose -f "$compose_file" exec -T "$service_name" bash -lc "$script" bash "$@"
  printf '\n'
  docker compose -f "$compose_file" exec -T "$service_name" bash -lc "$script" bash "$@"
}

cleanup_container() {
  run_compose down
}

check_workspace_layout() {
  if [[ -d "$legacy_goat_ros_path" && ! -d "$canonical_goat_ros_path" ]]; then
    cat >&2 <<'EOF'
Legacy goat_ros checkout detected at ros_ws/src.
The canonical nested repository path is ros_ws/src/goat_ros.
Move the existing checkout into ros_ws/src/goat_ros or remove ros_ws/src and rerun scripts/ros bootstrap.
EOF
    exit 1
  fi

  if [[ -d "$legacy_isaac_ros_common_path" && ! -d "$canonical_isaac_ros_common_path" ]]; then
    cat >&2 <<'EOF'
Legacy isaac_ros_common checkout detected at ros_ws/src/isaac_ros_common.
The canonical nested repository path is ros_ws/src/isaac_ros/isaac_ros_common.
Move the existing checkout into ros_ws/src/isaac_ros/isaac_ros_common or remove ros_ws/src/isaac_ros_common and rerun scripts/ros bootstrap.
EOF
    exit 1
  fi
}

is_running() {
  local services
  services="$(docker compose -f "$compose_file" ps --status running --services)"
  [[ "$services" == *"$service_name"* ]]
}

ensure_running() {
  if is_running; then
    return
  fi

  echo "Container '$service_name' is not running; starting it now."
  run_compose up -d
}

command="${1:-}"
if [[ -z "$command" || "$command" == "-h" || "$command" == "--help" ]]; then
  usage
  exit 0
fi
shift

case "$command" in
  up)
    run_compose up -d
    ;;
  down)
    run_compose down
    ;;
  build)
    check_workspace_layout
    ensure_running
    trap cleanup_container EXIT
    run_in_container \
      "set -eo pipefail; source /opt/ros/humble/setup.bash; set -u; cd '$workspace_dir'; colcon --log-base '$build_root/log' build --base-paths ${workspace_source_roots[*]} --build-base '$build_root/build' --install-base '$build_root/install' --event-handlers console_direct+ \"\$@\"" \
      "$@"
    ;;
  test)
    check_workspace_layout
    ensure_running
    trap cleanup_container EXIT
    run_in_container \
      "set -eo pipefail; source /opt/ros/humble/setup.bash; cd '$workspace_dir'; colcon --log-base '$build_root/log' build --base-paths ${workspace_source_roots[*]} --build-base '$build_root/build' --install-base '$build_root/install' --event-handlers console_direct+; source '$build_root/install/setup.bash'; set -u; colcon --log-base '$build_root/log' test --base-paths ${workspace_source_roots[*]} --build-base '$build_root/build' --install-base '$build_root/install' --event-handlers console_direct+ --return-code-on-test-failure \"\$@\"; colcon test-result --test-result-base '$build_root/build' --verbose" \
      "$@"
    ;;
  bootstrap)
    check_workspace_layout
    ensure_running
    trap cleanup_container EXIT
    run_in_container \
      "set -eo pipefail; source /opt/ros/humble/setup.bash; set -u; cd '$workspace_root'; git config --global --add safe.directory '$workspace_root'; while IFS= read -r git_dir; do git config --global --add safe.directory \"\$(dirname \"\$git_dir\")\"; done < <(find '$workspace_root/external' '$workspace_root/ros_ws/src' -mindepth 1 -maxdepth 4 -type d -name .git 2>/dev/null | sort || true); mapfile -t manifest_paths < <(find '$workspace_root' -maxdepth 1 -type f -name '*.repos' | sort); if [[ \${#manifest_paths[@]} -eq 0 ]]; then echo 'No .repos manifests found at workspace root.' >&2; exit 1; fi; for manifest_path in \"\${manifest_paths[@]}\"; do echo \"Importing repositories from \$manifest_path\"; vcs import '$workspace_root' < \"\$manifest_path\"; done; rosdep update; rosdep install --from-paths ${workspace_source_roots[*]} --ignore-src -t build -t build_export -t buildtool -t buildtool_export -t exec --rosdistro humble -r -y; cd '$workspace_dir'; colcon --log-base '$build_root/log' build --base-paths ${workspace_source_roots[*]} --build-base '$build_root/build' --install-base '$build_root/install' --event-handlers console_direct+; echo; echo 'Bootstrap complete. Next step: scripts/demo'" \
      "$@"
    ;;
  *)
    echo "Unknown command: $command" >&2
    usage >&2
    exit 1
    ;;
esac
