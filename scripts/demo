#!/usr/bin/env bash
# Run the canonical GOAT robot bringup demo.
#
# Purpose:
#   Start the shared ROS container when needed, source the built workspace, and
#   launch the canonical GOAT robot bringup entrypoint.
#
# Inputs:
#   Optional ROS launch arguments for `goat_ros_launch robot.launch.py`.
#
# Outputs:
#   Starts the robot bringup demo inside the shared container and streams launch
#   output to the terminal.
#
# Usage:
#   scripts/demo
#   GOAT_TARGET=jetson scripts/demo
#   scripts/demo joy_dev:=/dev/input/js1 deadzone:=0.02
#   scripts/demo record:=true record_profile:=slam
#   GOAT_ROSBAG_DIR=ros_ws/bags/demo scripts/demo record:=true
#
# Notes:
#   Requires a completed `scripts/ros bootstrap` run so the workspace install
#   setup file exists. `GOAT_TARGET` selects the compose overlay and defaults
#   to `workstation`.
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
service_name="ros-humble"
workspace_root="/workspace/goat_racer"
workspace_install="/workspace/goat_racer/ros_ws/install/setup.bash"
default_rosbag_dir="ros_ws/bags"
default_target="workstation"
target="${GOAT_TARGET:-$default_target}"
compose_base_file="$repo_root/docker/compose.yaml"
compose_target_file="$repo_root/docker/compose.$target.yaml"
compose_args=(
  -f "$compose_base_file"
  -f "$compose_target_file"
)

validate_target() {
  case "$target" in
    workstation|jetson)
      ;;
    *)
      echo "Invalid GOAT_TARGET '$target'. Expected 'workstation' or 'jetson'." >&2
      exit 1
      ;;
  esac

  if [[ ! -f "$compose_target_file" ]]; then
    echo "Compose target file '$compose_target_file' does not exist." >&2
    exit 1
  fi
}

print_command() {
  printf 'Running:'
  printf ' %q' "$@"
  printf '\n'
}

is_running() {
  local services
  services="$(docker compose "${compose_args[@]}" ps --status running --services)"
  [[ "$services" == *"$service_name"* ]]
}

ensure_running() {
  if is_running; then
    return
  fi

  echo "Container '$service_name' for GOAT_TARGET='$target' is not running; starting it now."
  docker compose "${compose_args[@]}" up -d
}

validate_target

if [[ ! -f "$repo_root/ros_ws/install/setup.bash" ]]; then
  echo "Workspace install is missing. Run scripts/ros bootstrap first." >&2
  exit 1
fi

launch_args=("$@")
has_bag_dir=false
show_args=false
for arg in "$@"; do
  if [[ "$arg" == bag_dir:=* ]]; then
    has_bag_dir=true
  elif [[ "$arg" == "--show-args" ]]; then
    show_args=true
  fi
done

if [[ "$has_bag_dir" == false && "$show_args" == false ]]; then
  rosbag_dir="${GOAT_ROSBAG_DIR:-$default_rosbag_dir}"
  if [[ "$rosbag_dir" == /* ]]; then
    container_bag_dir="$rosbag_dir"
    if [[ "$rosbag_dir" == "$workspace_root/"* ]]; then
      mkdir -p "$repo_root/${rosbag_dir#"$workspace_root"/}"
    fi
  else
    mkdir -p "$repo_root/$rosbag_dir"
    container_bag_dir="$workspace_root/$rosbag_dir"
  fi
  launch_args+=("bag_dir:=$container_bag_dir")
fi

ensure_running

print_command docker compose "${compose_args[@]}" exec "$service_name" bash -lc \
  "source /opt/ros/humble/setup.bash && source '$workspace_install' && ros2 launch goat_ros_launch robot.launch.py \"\$@\"" \
  bash "${launch_args[@]}"

exec docker compose "${compose_args[@]}" exec "$service_name" bash -lc \
  "source /opt/ros/humble/setup.bash && source '$workspace_install' && ros2 launch goat_ros_launch robot.launch.py \"\$@\"" \
  bash "${launch_args[@]}"
