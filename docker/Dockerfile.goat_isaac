ARG BASE_IMAGE=arm64v8/ros:humble-ros-base
FROM ${BASE_IMAGE}

SHELL ["/bin/bash", "-lc"]

ARG ISAAC_ROS_APT_CHANNEL=release-3
ARG ISAAC_ROS_APT_SERIES=release-3.0

ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=en_US.UTF-8
ENV LC_ALL=en_US.UTF-8
ENV ROS_DISTRO=humble
ENV ROS_WS=/workspace/goat_racer/ros_ws

RUN apt-get update && apt-get install -y \
    ca-certificates \
    curl \
    git \
    gnupg \
    htop \
    iputils-ping \
    locales \
    python3-colcon-common-extensions \
    python3-rosdep \
    python3-vcstool \
    tmux \
    usbutils \
    && locale-gen en_US.UTF-8 \
    && update-locale LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://isaac.download.nvidia.com/isaac-ros/repos.key \
      | gpg --dearmor -o /usr/share/keyrings/isaac-ros-archive-keyring.gpg \
    && release_codename="$(. /etc/os-release && echo "${VERSION_CODENAME}")" \
    && echo "deb [signed-by=/usr/share/keyrings/isaac-ros-archive-keyring.gpg] https://isaac.download.nvidia.com/isaac-ros/${ISAAC_ROS_APT_CHANNEL} ${release_codename} ${ISAAC_ROS_APT_SERIES}" \
      > /etc/apt/sources.list.d/isaac-ros.list \
    && apt-get update \
    && rm -rf /var/lib/apt/lists/*

RUN rosdep init 2>/dev/null || true

COPY docker/entrypoint.sh /usr/local/bin/goat-entrypoint

RUN chmod +x /usr/local/bin/goat-entrypoint \
    && echo "source /opt/ros/${ROS_DISTRO}/setup.bash" >> /root/.bashrc \
    && echo "if [[ -f ${ROS_WS}/install/setup.bash ]]; then source ${ROS_WS}/install/setup.bash; fi" >> /root/.bashrc

WORKDIR /workspace/goat_racer
ENTRYPOINT ["/usr/local/bin/goat-entrypoint"]
CMD ["bash"]
